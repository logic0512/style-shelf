# Optional local overrides. The app stays localhost-only by default.
STYLE_SHELF_PORT=4317
STYLE_SHELF_FRONTEND_PORT=4173
STYLE_SHELF_DATA_DIR=.styleshelf-data
# Visible media library. Defaults to ~/Pictures/Style Shelf.
# STYLE_SHELF_LIBRARY_DIR=/absolute/path/to/Style Shelf
# CODEX_HOME=/absolute/path/to/.codex
# CODEX_BIN=/absolute/path/to/codex
# STYLE_SHELF_BUNDLED_SKILLS_DIR=/absolute/path/to/bundled-skills

# Executor: codex (default, uses local Codex image generation) or workbuddy.
# STYLE_SHELF_EXECUTOR=workbuddy
# WorkBuddy local HTTP service (codebuddy --serve). The password is printed at serve startup.
# Style Shelf only connects to this service; configure any image model API inside WorkBuddy.
# STYLE_SHELF_WORKBUDDY_BASE=http://127.0.0.1:8080
# STYLE_SHELF_WORKBUDDY_TOKEN=
