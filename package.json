{
  "name": "style-shelf",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "description": "Local-first image style Skill workbench",
  "author": "Style Shelf contributors",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test test/*.test.mjs",
    "preview": "vite preview",
    "start:mock": "node server/mock.mjs",
    "setup": "node scripts/setup.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "check:bundled-licenses": "node scripts/check-bundled-licenses.mjs",
    "doctor": "node scripts/doctor.mjs",
    "start": "node scripts/start.mjs",
    "desktop": "npm run build && electron electron/main.mjs",
    "pack:dir": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:mac:universal": "npm run build && electron-builder --mac --universal --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.0"
  },
  "build": {
    "appId": "com.styleshelf.app",
    "productName": "Style Shelf",
    "artifactName": "Style-Shelf-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/prune-electron-locales.mjs",
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "scripts/load-env.mjs",
      "bundled-skills/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asarUnpack": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "bundled-skills/**/*",
      "scripts/load-env.mjs"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "electronLanguages": [
        "en",
        "zh_CN"
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "electronLanguages": [
        "en-US",
        "zh-CN"
      ],
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "electronLanguages": [
        "en-US",
        "zh-CN"
      ],
      "target": [
        "AppImage"
      ]
    }
  }
}
